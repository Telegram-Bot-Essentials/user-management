{
    "name": "telegram-bot-essentials/user-management",
    "description": "Admin bot-user list with filters, sections and interaction logging for telegram-bot-essentials/essence",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12 || ^13",
        "telegram-bot-essentials/essence": "^0.12"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\UserManagement\\": "src/"
        },
        "files": [
            "bootstrap/canvas.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramBotEssentials\\UserManagement\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\UserManagement\\TbeUserManagementServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi",
            "@php vendor/bin/testbench workbench:sync-skeleton --ansi"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
